# Reglas iptables gestionadas por Ansible

*nat
:PREROUTING ACCEPT [0:0]
:INPUT ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]
# Las VM salen a internet con la IP del balanceador en la red NAT
-A POSTROUTING -s {{ red_datos }} -o {{ router_if_externa }} -j MASQUERADE
COMMIT

*filter
:INPUT ACCEPT [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]

# Solo se reenvía lo que sale de la red de datos y sus respuestas, no acepta conexiones desde el exterior
-A FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A FORWARD -i {{ router_if_interna }} -o {{ router_if_externa }} -s {{ red_datos }} -j ACCEPT
COMMIT
