# {{ ansible_managed }}
global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin
    stats timeout 30s
    user haproxy
    group haproxy
    daemon

defaults
    log     global
    mode    http
    option  httplog
    option  dontlognull
    timeout connect 5s
    timeout client  50s
    timeout server  50s

# Entrada de las aplicaciones (red NAT). Comparten IP y puerto: el nombre que
# pide el navegador decide a qué servidores va la petición
frontend http
    bind *:80
    acl es_nextcloud hdr(host),field(1,:) -i {{ dominio_nextcloud }}
    use_backend servidores_nextcloud if es_nextcloud
    default_backend servidores_web

# Servidores web, por la red de datos
backend servidores_web
    balance roundrobin
    # La IP del cliente llega a Apache en la cabecera X-Forwarded-For
    option forwardfor
    # Un servidor web que no responde deja de recibir peticiones
    option httpchk GET /
    # Persistencia: la aplicación guarda en la sesión de PHP (que vive en cada
    # servidor web) el token CSRF del formulario. La cookie SERVIDOR hace que
    # todas las peticiones de un navegador vayan al mismo servidor web
    cookie SERVIDOR insert indirect nocache
{% for servidor in groups['servidores_web'] %}
    server {{ servidor }} {{ hostvars[servidor]['ansible_host'] }}:80 check cookie {{ servidor }}
{% endfor %}

# Servidores de Nextcloud, por la red de datos
backend servidores_nextcloud
    balance roundrobin
    option forwardfor
    # Nextcloud solo responde a su nombre: la comprobación lleva la cabecera Host
    option httpchk
    http-check send meth GET uri /status.php ver HTTP/1.1 hdr Host {{ dominio_nextcloud }}
    http-check expect status 200
    # Persistencia: la sesión de PHP también es local de cada servidor
    cookie SERVIDOR insert indirect nocache
{% for servidor in groups['servidores_nextcloud'] %}
    server {{ servidor }} {{ hostvars[servidor]['ansible_host'] }}:80 check cookie {{ servidor }}
{% endfor %}

# Estadísticas: http://<IP del balanceador>:{{ haproxy_stats_puerto }}
listen estadisticas
    bind *:{{ haproxy_stats_puerto }}
    stats enable
    stats uri /
    stats refresh 10s
    stats auth {{ haproxy_stats_usuario }}:{{ haproxy_stats_password }}
