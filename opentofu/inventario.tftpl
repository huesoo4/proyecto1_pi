# Fichero generado por OpenTofu (opentofu/inventario.tf): no lo edites a mano
[servidores_web]
server-web1 ansible_host=${ip_server_web1} ansible_user=debian
server-web2 ansible_host=${ip_server_web2} ansible_user=debian

[servidores_bd]
server-db ansible_host=${ip_server_db} ansible_user=ubuntu

[servidores_nextcloud]
server-nextcloud1 ansible_host=${ip_server_nextcloud1} ansible_user=debian
server-nextcloud2 ansible_host=${ip_server_nextcloud2} ansible_user=debian

[servidores_bd_nextcloud]
server-db-nextcloud ansible_host=${ip_server_db_nextcloud} ansible_user=ubuntu

[balanceadores]
balanceador ansible_host=${ip_balanceador} ansible_user=debian ip_datos=10.0.50.1

[servidores:children]
servidores_web
servidores_bd
servidores_nextcloud
servidores_bd_nextcloud

# Las máquinas de Nextcloud comparten los datos de su base de datos y del
# almacenamiento (group_vars/nextcloud.yaml)
[nextcloud:children]
servidores_nextcloud
servidores_bd_nextcloud

[servidores:vars]
ansible_ssh_common_args='-o ProxyCommand="ssh -W %h:%p -q -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null debian@${ip_balanceador}"'
